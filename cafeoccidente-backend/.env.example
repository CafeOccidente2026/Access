DB_NAME=cafeoccidente
DB_USER=postgres
DB_PASSWORD=change-me

# Firma de los JWT (access + refresh). Minimo 32 caracteres (HS256).
JWT_SECRET=change-this-to-a-long-random-secret-of-at-least-32-characters

# Credenciales del primer usuario ADMIN, se crean automaticamente al arrancar
# si la tabla users esta vacia. Cambia la contraseña desde la pantalla de
# Usuarios apenas entres por primera vez.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-after-first-login
