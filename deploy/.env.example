# Copiar como deploy/.env y llenar. Nunca subir el .env a git.

# Dominio con el que entran los puntos (ej. compras.cafeoccidente.com) o el nombre del servidor en la intranet.
DOMINIO=compras.ejemplo.com
# auto = Let's Encrypt (dominio publico) | interno = certificado propio de Caddy (intranet)
TLS_MODO=auto

DB_NAME=cafeoccidente
DB_USER=cafeoccidente
DB_PASSWORD=cambiar
# Minimo 32 caracteres al azar (ej. openssl rand -base64 48)
JWT_SECRET=cambiar
# Administrador inicial: se crea solo si no existe
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar

# Dias que se guardan los respaldos diarios (23:00 hora de Colombia)
RESPALDO_DIAS=30
# Carpeta del servidor donde quedan los respaldos (copiarla fuera del servidor)
CARPETA_RESPALDOS=./respaldos

# Solo si el 80 y el 443 estan ocupados (con Let's Encrypt deben ser 80 y 443)
# PUERTO_HTTP=80
# PUERTO_HTTPS=443
